{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 80,
	"trailingComma": "all",
	"proseWrap": "always",
	"sortPackageJson": false,
	"ignorePatterns": [
		".agents/skills/",
		".claude/skills/",
		"**/_generated/",
		"CHANGELOG.md",
		"skills-lock.json"
	],
	"overrides": [
		{
			"files": ["*.json", "*.md", "*.yml", "*.yaml"],
			"options": { "useTabs": false }
		}
	]
}
